PORT=8080
ENV=development

DB_PATH=./data/monitoring.db

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Telegram Configuration
BOT_TELEGRAM_TOKEN=your-telegram-bot-token
TELEGRAM_ID=your-chat-id

# Discord Configuration
BOT_DISCORD_TOKEN=your-discord-bot-token
DISCORD_CHANNEL_ID=your-channel-id

FRONT_END_URL=http://localhost:3000

# Temperature Alert Thresholds (in Celsius)
TEMP_ALERT_CPU_THRESHOLD=80.0
TEMP_ALERT_MCU_THRESHOLD=30.0

# Humidity Thresholds (in %)
# MCU humidity safe range: min to max
HUMIDITY_SAFE_MIN=40.0
HUMIDITY_SAFE_MAX=60.0

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://monitor.scholair.my.id
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=Content-Type,Authorization,Accept,Origin

HTTPS_INSECURE_SKIP_VERIFY=false
